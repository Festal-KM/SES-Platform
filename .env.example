# ============================================================================
# .env.example
#
# このファイルをコピーして .env を作る:
#   cp .env.example .env
#
# 🔴 .env はコミットしない (.gitignore で除外済み)。
# 🔴 このファイルには実際のキーを書かない。プレースホルダのままコミットする。
# ⚠️ 例外: AUTH_SECRET 等の暗号鍵・署名鍵は、ローカル開発専用のダミー値をそのまま同梱する
#    (openssl rand -base64 32 等で生成した使い捨ての値。本番・sandbox・staging の鍵とは無関係)。
#    これは外部サービスの API キー・シークレットとは異なり、ローカル docker-compose の中だけで
#    完結し外部に送信されないため、プレースホルダにする必要がない。
# ============================================================================

# ----------------------------------------------------------------------------
# ワイヤーフレーム画像生成 (scripts/generate-wireframes.mjs / designer エージェント)
# ----------------------------------------------------------------------------

# 使用するプロバイダ: openai | gemini
WIREFRAME_IMAGE_PROVIDER=openai

# 🔴 モデル名はスクリプトにハードコードしない。ここで指定する。
#    モデルは頻繁に更新されるため、実行前に各プロバイダの公式ドキュメントで
#    現行のモデル ID を確認すること。
#      openai の例: gpt-image-1
#      gemini の例: gemini-2.5-flash-image
WIREFRAME_IMAGE_MODEL=

# 画質。プロバイダが対応する場合のみ送信される (未設定なら送らない)
#   openai: low | medium | high
WIREFRAME_IMAGE_QUALITY=

# 画像サイズ。designer エージェントの契約により mobile.png のみ縦長が使われる
WIREFRAME_IMAGE_SIZE_LANDSCAPE=1536x1024
WIREFRAME_IMAGE_SIZE_PORTRAIT=1024x1536

# API ベース URL の上書き (プロキシ経由・互換 API を使う場合のみ)
# WIREFRAME_API_BASE_URL=

# API キー。WIREFRAME_IMAGE_PROVIDER に対応するものだけ設定すればよい
OPENAI_API_KEY=
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# プロダクト側の環境変数
#
# ここから下は CLAUDE.md §2 / §11 を埋めたあとに、プロダクトが必要とするものを
# 追記していく。CLAUDE.md §3.5 のハードルールにより、環境変数は起動時に
# スキーマ検証されるため、追加したらスキーマ側にも追加すること。
# ----------------------------------------------------------------------------

APP_ENV=development
NODE_ENV=development

# ----------------------------------------------------------------------------
# ローカル開発コンテナ (docker-compose.yml / T-01-02)
#
# `docker compose up -d` で起動する PostgreSQL / Redis / MinIO / MailHog / ClamAV への
# 既定の接続情報。docker-compose.yml はこのファイル (.env) を自動で読み込む。
# 🔴 ここでの資格情報はローカル専用の既定値であり、本番相当の環境には流用しない。
# packages/config の Zod スキーマ (T-01-03) がこれらを起動時に検証する。
# ----------------------------------------------------------------------------

# PostgreSQL（docker-compose.yml の postgres サービス）
POSTGRES_USER=ses
POSTGRES_PASSWORD=ses_dev_password
POSTGRES_DB=ses_platform
POSTGRES_PORT=5432
# 🔴 POSTGRES_PORT を変更したら、下の DATABASE_URL / PLATFORM_DATABASE_URL のポートも
#    同じ値に直すこと。ホスト側で 5432 が使用中（例: 別の PostgreSQL がネイティブ稼働中）なら
#    POSTGRES_PORT=15432 等に変更する。ポートだけ変えて URL を放置すると、アプリが他のプロセスの
#    PostgreSQL に接続してしまう。同様の対応関係が REDIS_PORT ↔ REDIS_URL / MINIO_API_PORT ↔
#    S3_ENDPOINT / MAILHOG_SMTP_PORT ↔ SMTP_PORT にもあるので、変更時は両方を揃えること。

# ロール別パスワード（docker/postgres/initdb/000-roles.sh が packages/db/prisma/sql/000_roles.sql
# を適用するときに使う。docs/05 §4.2 の 5 ロール。ローカル専用のダミー値）。
APP_MIGRATOR_PASSWORD=app_migrator_dev_password
APP_TENANT_PASSWORD=app_tenant_dev_password
APP_PLATFORM_PASSWORD=app_platform_dev_password
APP_PLATFORM_WRITE_PASSWORD=app_platform_write_dev_password

# T-01-05 で決定・実装済み: development も他環境と同じ検証を受ける
#    （development 例外は T-01-05 でロールが実在するようになった時点で解除した。docs/05 §4.2 / §13.4
#    規則 3・4）。DATABASE_URL（app_tenant ロール）と PLATFORM_DATABASE_URL（app_platform ロール）は
#    別ロール・別値にし、両方とも sslmode=require を含める。ローカルの docker-compose PostgreSQL は
#    自己署名証明書で TLS を有効化している（docker/postgres/entrypoint-ssl.sh。証明書検証はしないため
#    sslmode=require で足りる。verify-full 相当は staging/production のマネージド DB の話）。
DATABASE_URL=postgresql://app_tenant:app_tenant_dev_password@localhost:5432/ses_platform?sslmode=require
PLATFORM_DATABASE_URL=postgresql://app_platform:app_platform_dev_password@localhost:5432/ses_platform?sslmode=require
# 🔴 T-03-07: app_platform_write ロール（docs/05 §4.2 の「使う接続文字列」欄 =
#    PLATFORM_WRITE_DATABASE_URL）。運営者認証（F-055）と withPlatformWrite（T-03-08）が使う。
#    DATABASE_URL / PLATFORM_DATABASE_URL のいずれとも別値であること（起動時検証で拒否される）。
PLATFORM_WRITE_DATABASE_URL=postgresql://app_platform_write:app_platform_write_dev_password@localhost:5432/ses_platform?sslmode=require
# 🔴 MIGRATION_DATABASE_URL はアプリの実行時環境には設定しない（development を含む全環境で
#    起動時検証が失敗する。docs/05 §4.2 / §13.4 規則 3）。マイグレーション（prisma db push /
#    migrate）を手元で実行するときだけ、コマンドの直前に一時的に指定する。値の組み立て方は
#    tests/isolation/support/postgres.ts の migratorUrl と同じ（app_migrator ロール）:
#      postgresql://app_migrator:app_migrator_dev_password@localhost:5432/ses_platform?sslmode=require

# 🔴 SEED_DATABASE_URL も同じ扱い（アプリの実行時環境には置かない。packages/config の
#    envSchema にも載せない）。`pnpm seed --preset=isolation --reset`（合成データの投入・リセット。
#    docs/05 §13.6 / F-053）を実行するときだけ、コマンドの直前に指定する。
#    🔴 app_tenant は tenants に INSERT できず、テーブル所有者 app_migrator も
#    FORCE ROW LEVEL SECURITY により適用ポリシーが 0 件で読み書きできない（docs/05 §4.2 / §4.4）。
#    したがってシードには PostgreSQL のスーパーユーザー（ローカルは POSTGRES_USER）を使う:
#      APP_ENV=development SEED_DATABASE_URL=postgresql://ses:ses_dev_password@localhost:5432/ses_platform?sslmode=require \
#        pnpm seed --preset=isolation --reset
#    🔴 APP_ENV が development / demo 以外なら実行前に拒否される（F-053 AC-6）。

# Redis（docker-compose.yml の redis サービス）
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO（S3 互換。docker-compose.yml の minio サービス）
S3_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=ses-platform-dev
S3_ACCESS_KEY_ID=ses_dev_minio
S3_SECRET_ACCESS_KEY=ses_dev_minio_secret
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# MailHog（SMTP キャプチャ。docker-compose.yml の mailhog サービス）
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# ClamAV（docker-compose.yml の clamav サービス）
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 認証・暗号 (packages/config T-01-03 / docs/03 §6.2)
# 🔴 以下はローカル開発専用のダミー値であり、本番・sandbox・staging には流用しない。
#    `openssl rand -base64 32` 等で各自再生成してもよい。
# ----------------------------------------------------------------------------
AUTH_SECRET=Sg6ep7Ma0iJ61qZKHR7Ie5yBAe4zlnk/9F+D8IQhB0E=
AUTH_PLATFORM_SECRET=LXIWYVsfMdw9etr3Qywq5Q42dwNpJYOd/T7OAJ8ok4M=
TOKEN_ENCRYPTION_KEY=xI09L6CeY3xhEDonNWgy8QonzGi0nb2aQ6cKmM/4q/g=
TOKEN_ENCRYPTION_KEY_ID=k1
ANON_REFERENCE_HMAC_SECRET=0+p9363kM+jHstURWE17q+UWWvxqvNe9s4OmvTHZzP4=
WEBHOOK_PATH_SECRET=sfk1d1DkE0TKg/xtwiGmFZH5suGNqlSEGsftQL1iuE8=

# ----------------------------------------------------------------------------
# AI (Anthropic) (packages/config T-01-03 / docs/03 §6.3)
# development / demo は ANTHROPIC_API_KEY 不要（すべてモック。CLAUDE.md §11.1）。
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MONTHLY_SPEND_CAP_USD=100
AI_DAILY_COST_LIMIT_USD_DEFAULT=5

# ----------------------------------------------------------------------------
# AWS / Amazon SES (packages/config T-01-03 / docs/03 §6.4)
# development は実際に AWS を呼ばない（メール送信は MailHog 経由のモック。docs/03 §4.18.1
# 「development: AWS アカウントなし」）。以下はスキーマ整合のためのローカル専用ダミー値。
# ----------------------------------------------------------------------------
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=100000000001
AWS_ACCOUNT_ID_EXPECTED_PRODUCTION=999999999999
SES_DEFAULT_FROM_ADDRESS=no-reply@example.com
SES_CONFIGURATION_SET=ses-platform-dev
SES_GLOBAL_RATE_PER_SECOND=14

# ----------------------------------------------------------------------------
# 監視・ログ (packages/config T-01-03 / docs/03 §6.8)
# SENTRY_DSN は development では不要（未設定可）。SENTRY_ENVIRONMENT は APP_ENV と一致させる。
# ----------------------------------------------------------------------------
SENTRY_ENVIRONMENT=development
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# スケジュール・上限 (packages/config T-01-03 / docs/03 §6.9)
# 既定値のあるものは省略可（packages/config の Zod スキーマが補完する）。
# SCHEDULER_TIMEZONE のみ既定を持たせず、常に明示させる（CLAUDE.md §4.6）。
# ----------------------------------------------------------------------------
SCHEDULER_TIMEZONE=Asia/Tokyo
