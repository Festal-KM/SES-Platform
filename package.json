{
  "name": "ses-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tests.json && pnpm -r run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:smoke": "vitest run -c vitest.smoke.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
