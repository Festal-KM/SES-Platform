{
  "name": "ses-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tests.json && pnpm -r run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "test:isolation": "vitest run -c vitest.isolation.config.ts",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "seed": "pnpm --filter @ses/db run seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@ses/connectors": "workspace:*",
    "@ses/db": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.4.1",
    "eslint": "9.39.5",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
