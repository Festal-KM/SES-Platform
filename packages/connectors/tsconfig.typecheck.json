{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 🔴 `pnpm typecheck` 用。build（tsconfig.json）はテストを出荷物から外すが、
  //    型検査は **テストも含めて**行う。`src/queues.test.ts` の `@ts-expect-error` は
  //    「`attempts: 2` が実際にコンパイルエラーになる」ことをここで検査される
  //    （型検査されなければ、その行は単なるコメントと同じで何も保証しない）。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "exclude": []
}
