{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    // 🔴 seed/cli.ts（`pnpm seed` の実行可能エントリ）が `node:process` を import するため、
    //    このパッケージだけ Node の型を有効にする（ルートの tsconfig.json は "types": []）。
    //    他のパッケージ（とくに packages/domain）には広げない。
    "types": ["node"]
  },
  "include": ["src", "seed"]
}
