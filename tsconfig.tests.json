{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // 🔴 T-03-04: 型宣言を出力しないプロジェクトで `declaration` を立てたままにすると、
    //    「型に名前を付けられない」系の可搬性エラー（TS2883）だけがここで発生する
    //    （`apps/web` 自身の tsconfig は `declaration: false`。next-auth の内部型がその典型）。
    //    テストは .d.ts を出さないため、明示的に落とす。**型検査の厳しさは変わらない。**
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "allowJs": true,
    // 🔴 T-03-01: Vitest（Vite の解決）と同じ規則で型検査する。
    //    tests/** は `packages/**`（NodeNext）だけでなく `apps/web/**`（Next.js = bundler。
    //    相対 import に拡張子を付けない）も import するため、ルートの NodeNext のままでは
    //    apps/web のモジュールを解決できない。bundler は「拡張子あり（.js → .ts の読み替え）」も
    //    「拡張子なし」も解決できるので、既存の tests/** の書き方（.js 付き）はそのまま通る。
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "tests/**/*.ts",
    // 🔴 T-03-04: `tests/**` は `apps/web/**` の実装を直接 import する（結合テストがサーバを
    //    立てずに同じ経路を実行するため）。その中には Auth.js の型拡張（`declare module`）に
    //    依存するモジュールがあり、宣言ファイルを include しないと**このプロジェクトでだけ**
    //    型エラーになる（`apps/web` 自身の tsconfig では通る）。
    //    実装を追加するのではなく、既にある宣言を同じプログラムに載せるだけである。
    "apps/**/*.d.ts",
    "vitest.config.ts",
    "vitest.smoke.config.ts",
    "vitest.isolation.config.ts"
  ],
  // 🔴 T-03-11: `tests/e2e/**` のうち **`@playwright/test` に依存する部分だけ**を外す
  //    （`*.spec.ts` と `support/**`）。Playwright は E2E 実行環境にしか入っていないため、
  //    ここに含めると Playwright 未導入の環境で `pnpm typecheck` が丸ごと落ちる。
  //    ハーネス（`tests/e2e/harness/**` / `global-setup.ts` / `global-teardown.ts`）は
  //    Playwright に依存しないので**ここで型検査する**（E2E 基盤を無検査にしない）。
  //    仕様側は `pnpm typecheck:e2e`（`tsconfig.e2e.json`）が検査する。
  "exclude": ["tests/static/__fixtures__/**", "tests/e2e/**/*.spec.ts", "tests/e2e/support/**"]
}
